<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac 每日对话自动归档定时任务（模板）
  每天 23:30 触发

  使用前必改：
  1. Label 里的 PROJECT_NAME 改成你的项目英文名
  2. WorkingDirectory 改成 Mac 上的项目绝对路径
  3. 复制到 ~/Library/LaunchAgents/ 后 launchctl load
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.PROJECT_NAME.auto-summary</string>
    <key>ProgramArguments</key>
    <array>
        <string>node</string>
        <string>scripts/auto-summary.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/你的用户名/项目路径</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/PROJECT_NAME_auto_summary.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/PROJECT_NAME_auto_summary.log</string>
</dict>
</plist>
