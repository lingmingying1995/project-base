<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac Git 自动同步定时任务（模板）
  每天 23:50 触发

  使用前必改：
  1. Label 里的 PROJECT_NAME 改成你的项目英文名
  2. WorkingDirectory 改成 Mac 上的项目绝对路径
  3. 复制到 ~/Library/LaunchAgents/ 后 launchctl load
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.PROJECT_NAME.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>scripts/sync.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/你的用户名/项目路径</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>50</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/PROJECT_NAME_sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/PROJECT_NAME_sync.log</string>
</dict>
</plist>
